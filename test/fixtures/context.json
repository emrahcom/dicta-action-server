{
  "site": {
    "name": "Teamboard",
    "desc": "A task list for a small team.\n\n## Words\n\nUsers say \"card\" for a task."
  },
  "state": {
    "desc": "The open page and the tasks it shows."
  },
  "capabilities": [
    {
      "name": "tasks.list",
      "level": "read",
      "desc": "Lists the tasks.",
      "args": { "type": "object", "properties": {} }
    },
    {
      "name": "tasks.create",
      "level": "write",
      "desc": "Adds a task.",
      "args": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "due": { "type": "string", "description": "Date, YYYY-MM-DD" }
        },
        "required": ["title"]
      }
    },
    {
      "name": "tasks.open",
      "level": "read",
      "desc": "Loads the page of a task.",
      "args": {
        "type": "object",
        "properties": { "id": { "type": "string" } },
        "required": ["id"]
      }
    }
  ]
}
